<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tortoisebot_description</name>
  <version>0.0.0</version>
  <description>TortoiseBot URDF/xacro models, meshes and RViz configurations,
    plus the robot_state_publisher launch files that load them.</description>
  <maintainer email="shubhamnandi12@gmail.com">sub22</maintainer>
  <maintainer email="vinayaknayak@rigbetellabs.com">Vinayak</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <!-- ReplaceString, used to fill in the namespaced RViz config. -->
  <exec_depend>nav2_common</exec_depend>

  <!-- The .xacro models are expanded at launch time by Command(['xacro ', ...]),
       so xacro is a runtime dependency, not just a build-time one. -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>urdf</exec_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
