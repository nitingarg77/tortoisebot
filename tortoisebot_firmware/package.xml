<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tortoisebot_firmware</name>
  <version>0.0.0</version>
  <description>Raspberry Pi motor driver for TortoiseBot. Converts cmd_vel into
    open-loop GPIO PWM; there are no encoders, so it publishes no odometry.</description>
  <maintainer email="shubhamnandi@rigbetellabs.com">Shubham</maintainer>
  <maintainer email="vinayaknayak@rigbetellabs.com">Vinayak</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- rclcpp carries no C++ source here, but CMakeLists.txt does
       find_package(rclcpp REQUIRED), so the build fails without it. -->
  <depend>rclcpp</depend>
  <depend>rclpy</depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <!-- differential.py also imports RPi.GPIO, which has no rosdep key and is
       Raspberry Pi only. Install it with pip on the robot; see README 1.3. -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
