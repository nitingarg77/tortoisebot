<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tortoisebot_gazebo</name>
  <version>0.0.0</version>
  <description>Ignition Gazebo worlds, sensor plugin configuration and the
    bridge/launch files that run TortoiseBot in simulation.</description>
  <maintainer email="shubhamnandi@rigbetellabs.com">Shubham</maintainer>
  <maintainer email="vinayaknayak@rigbetellabs.com">Vinayak</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- RewrittenYaml, used to namespace the EKF params. -->
  <exec_depend>nav2_common</exec_depend>

  <!-- sim_covariance_relay.py -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <!-- Ignition Fortress integration. -->
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <!-- ignition_sim.launch.py starts ekf_filter_node using the parameter file
       from tortoisebot_navigation/config/ekf_mapbased.yaml. -->
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>tortoisebot_description</exec_depend>
  <exec_depend>tortoisebot_navigation</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
